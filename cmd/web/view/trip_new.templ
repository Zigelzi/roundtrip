package view

import "strconv"

// NewTrip is the create-trip form. today (YYYY-MM-DD) greys out past dates in
// the phone's date picker; the server still enforces the rule. The form is
// novalidate: the browser's own popups are easy to miss on a phone, so the
// server checks everything and shows all problems in one red box.
templ NewTrip(form TripForm, today string) {
	@Layout("New trip") {
		<header class={ barClass }>
			<div class="flex min-h-16 items-center gap-1 py-2 pr-4 pl-1">
				@backLink("/", "Back to trips")
				<h1 class="min-w-0 grow truncate text-lg font-bold">New trip</h1>
			</div>
		</header>
		@errorList(form.Errors)
		<form method="post" action="/trips" novalidate class={ sectionClass + " mt-2 space-y-5 p-4" }>
			<label class="block">
				<span class={ fieldLabelClass }>Destination</span>
				<input type="text" name="destination" value={ form.Destination } required class={ inputClass }/>
			</label>
			<div class="grid grid-cols-2 gap-3">
				<label class="block min-w-0">
					<span class={ fieldLabelClass }>Departure</span>
					<input type="date" name="departure_date" value={ form.DepartureDate } min={ today } required class={ inputClass }/>
				</label>
				<label class="block min-w-0">
					<span class={ fieldLabelClass }>Return</span>
					<input type="date" name="end_date" value={ form.EndDate } min={ today } class={ inputClass }/>
				</label>
			</div>
			<label class="block w-28">
				<span class={ fieldLabelClass }>Days</span>
				<input type="number" name="duration_days" value={ form.DurationDays } min="1" step="1" inputmode="numeric" class={ inputClass }/>
			</label>
			<fieldset>
				<legend class={ fieldLabelClass }>Who is going</legend>
				<div class="mt-1 grid grid-cols-2 gap-2">
					for _, p := range form.People {
						<label class="group">
							<input type="checkbox" name="members" value={ strconv.FormatInt(p.ID, 10) } checked?={ p.Ticked } class="peer sr-only"/>
							<span class={ personToggleClass }>
								<span class={ tickBoxClass }>
									@iconTick("size-4 stroke-3")
								</span>
								<span class="truncate">{ p.Name }</span>
							</span>
						</label>
					}
				</div>
			</fieldset>
			@syncTripDates()
			<button type="submit" class={ primaryButtonClass + " w-full disabled:opacity-50" }>Create trip</button>
		</form>
	}
}

// personToggleClass is a person's toggle, driven by the hidden checkbox
// before it. Going is the action colour's tint with a 2px primary edge (a
// 1px border plus a 1px inset ring, so nothing shifts when it changes);
// not going is a plain grey edge and muted text. The tick box beside the
// name (tickBoxClass) fills when going, so going does not rely on colour
// alone. The tick is an aria-hidden icon: a screen reader already says
// "checked" for the box.
const personToggleClass = "flex min-h-14 w-full items-center gap-3 rounded-control border border-line-strong bg-surface px-3 font-semibold text-muted peer-checked:border-primary peer-checked:bg-primary-soft peer-checked:text-ink peer-checked:ring-1 peer-checked:ring-primary peer-checked:ring-inset peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary"

// tickBoxClass is the tick box inside a person's toggle: an empty grey
// square when not going, a filled primary one with a white tick when going.
// The tick is drawn in the text colour, transparent until ticked.
const tickBoxClass = "flex size-6 shrink-0 items-center justify-center rounded-box border-2 border-line-strong bg-surface text-transparent group-has-[:checked]:border-primary group-has-[:checked]:bg-primary group-has-[:checked]:text-white"

// syncTripDates keeps duration and return date in step while typing:
// changing the days or the departure moves the return date; changing the
// return date recalculates the days. Dates are handled as UTC midnight, so
// there are no daylight-saving surprises in the day arithmetic. It also
// disables Create once the form is submitted.
templ syncTripDates() {
	<script>
		(() => {
			const form = document.currentScript.closest("form");
			const departure = form.elements["departure_date"];
			const end = form.elements["end_date"];
			const days = form.elements["duration_days"];
			const dayMs = 24 * 60 * 60 * 1000;

			function updateEnd() {
				const d = Date.parse(departure.value);
				const n = parseInt(days.value, 10);
				if (departure.value) end.min = departure.value;
				if (!isNaN(d) && n >= 1) end.value = new Date(d + (n - 1) * dayMs).toISOString().slice(0, 10);
			}
			function updateDays() {
				const d = Date.parse(departure.value);
				const e = Date.parse(end.value);
				if (!isNaN(d) && !isNaN(e) && e >= d) days.value = Math.round((e - d) / dayMs) + 1;
			}

			departure.addEventListener("input", updateEnd);
			days.addEventListener("input", updateEnd);
			end.addEventListener("input", updateDays);

			// One trip per tap: a quick double tap would otherwise post twice.
			// Re-enable when the browser restores this page from its cache.
			// The button is looked up when used: this script runs before the
			// button below it has been parsed.
			const submit = () => form.querySelector("button[type=submit]");
			form.addEventListener("submit", () => { submit().disabled = true; });
			window.addEventListener("pageshow", (e) => { if (e.persisted) submit().disabled = false; });
		})();
	</script>
}

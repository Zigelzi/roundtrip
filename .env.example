# Copy to .env and fill in. .env is gitignored — it is where anything that
# should not be in a public repository lives.
#
# `make run`, `make run-lan` and `make dev` load .env automatically. On the Pi,
# point systemd at the file instead with EnvironmentFile=.
#
# Do not quote values: make passes them through literally, so quotes would end
# up as part of the name.

# The family members' display names, in the same order as the migration seeds
# them: the two parents, then the children. A blank entry keeps that member's
# placeholder name. Leave the whole line out and the app runs with placeholders.
FAMILY_NAMES=Parent 1,Parent 2,Child 1,Child 2

# Where the SQLite file lives (default: roundtrip.db in the working directory).
# DB_PATH=roundtrip.db

# Listen address. The default only accepts connections from this machine; the
# `run-lan` and `dev` targets set it to 0.0.0.0 so a phone can reach the app.
# ADDR=127.0.0.1:8080

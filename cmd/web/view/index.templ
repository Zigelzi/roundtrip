package view

// Index is the front page: the family's trips, upcoming first. Its top bar
// bleeds through the page's padding to the screen edges, like the sections
// below it. Basics sits beside the title (09/R8), so New trip is the one
// solid button.
templ Index(trips []Trip) {
	@Layout("Trips") {
		<header class={ barClass }>
			<div class="flex min-h-16 items-center gap-1 px-4 py-2">
				<h1 class="grow text-2xl font-bold tracking-tight">Roundtrip</h1>
				<a href={ templ.SafeURL(BasicsURL) } class={ secondaryButtonClass }>Basics</a>
			</div>
			<div class="px-4 pb-4">
				<a href="/trips/new" class={ primaryButtonClass + " w-full" }>
					@iconPlus()
					New trip
				</a>
			</div>
		</header>
		if len(trips) == 0 {
			<section class={ sectionClass + " mt-2 flex flex-col items-center gap-2 px-6 py-8 text-center" }>
				<span class="text-faint">
					@iconBag()
				</span>
				<h2 class="text-lg font-bold">No trips yet</h2>
				<p class="max-w-70 text-[15px] leading-[22px] text-muted">A new trip starts with everyone's basics already on the list, so check those first.</p>
				<a href={ templ.SafeURL(BasicsURL) } class={ quietButtonClass + " mt-1" }>Check basics</a>
			</section>
		} else {
			<ul class={ sectionClass + " mt-2 divide-y divide-line" }>
				for _, trip := range trips {
					<li>
						<a href={ templ.SafeURL(TripURL(trip.ID)) } class="flex min-h-19 items-center gap-3 py-3 pr-2 pl-4">
							<span class="min-w-0 grow">
								<span class="block text-[17px] leading-6 font-semibold">{ trip.Destination }</span>
								<span class="block text-sm text-muted">{ FormatDateRange(trip.Departure, trip.DurationDays) } · { FormatDays(trip.DurationDays) }</span>
							</span>
							<span class="text-faint">
								@iconForward()
							</span>
						</a>
					</li>
				}
			</ul>
		}
	}
}

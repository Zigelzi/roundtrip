package view

// PackPage is the screen used while standing at the bag. It reuses the trip
// page's <section data-member="Name"> contract, but carries no add form and
// no remove button: packing must not be one mis-tap away from deleting an
// item.
//
// Tests cut an htmx reply into its swap targets by their ids, using the id
// prefixes listed in packFragment (pack_toggle_test.go). A new swap target
// needs its prefix added there, or the fragment before it swallows it.
templ PackPage(page PackPageData) {
	@Layout("Packing · " + page.Trip.Destination) {
		<header class={ topBarClass }>
			<div class="flex min-h-16 items-center gap-1 py-2 pr-4 pl-1">
				@backLink(TripURL(page.Trip.ID), "Back to trip")
				<div class="min-w-0 grow">
					<h1 class="truncate text-lg font-bold">{ page.Trip.Destination }</h1>
					@PackProgress(page, false)
				</div>
			</div>
		</header>
		if page.TripTotal == 0 {
			<div class={ sectionClass + " mt-2 px-4 pt-4 pb-2" }>
				<p class="text-muted">Nothing to pack yet.</p>
				<a href={ templ.SafeURL(TripURL(page.Trip.ID)) } class={ quietButtonClass + " -ml-3 gap-1" }>
					Add items to the trip
					@iconForward()
				</a>
			</div>
		} else {
			@filterNav(page)
			<div class="mt-2 space-y-2">
				for _, m := range page.Shown() {
					@packMemberSection(page, m)
				}
			</div>
		}
	}
}

// PackProgress is the top bar's meta line, how much of the list is in the
// bag. It is swapped on every tap, so the "everything is packed" notes live
// here too. It sits in the sticky header, so the notes are kept to a slim
// line.
templ PackProgress(page PackPageData, oob bool) {
	<div id="pack-progress" { oobAttrs(oob)... }>
		<p class="truncate text-sm text-muted tabular-nums">{ packMeta(page) }</p>
		if page.TripTotal > 0 && page.TripPacked == page.TripTotal {
			@doneNote() {
				Everything is packed.
			}
		} else if page.Filter != 0 && page.Total > 0 && page.Packed == page.Total {
			@doneNote() {
				if page.Filter == page.FamilyBucketID {
					The family's things are packed.
				} else {
					{ page.FilteredName() } is packed.
				}
				{ FormatProgress(page.TripPacked, page.TripTotal) } on the trip.
			}
		}
	</div>
}

// doneNote is a short note in the packed colour with a tick, for something
// finished: the whole trip, one person, or one person's list.
templ doneNote() {
	<p class="mt-1.5 flex items-start gap-2 rounded-chip bg-packed-soft px-3 py-2 text-sm font-semibold text-packed">
		@iconTick("mt-0.5 size-4")
		<span>
			{ children... }
		</span>
	</p>
}

// filterNav narrows the page to one person, or to the whole family. Plain
// links, so the choice lives in the URL and survives every tap. Six links do
// not fit on one line at phone width (03/S9), so they sit in a grid of three
// equal columns, two rows for a family of four plus Everyone and Family,
// instead of a wrapping flex row: a grid stays tidy however long a
// FAMILY_NAMES entry is (a long one is cut short), and never needs
// horizontal scrolling, which would push Family off-screen on first paint
// (the reason it is ordered second in FilterOrder, not last). It is a white
// band under the top bar, not part of it, so it scrolls away with the list.
templ filterNav(page PackPageData) {
	<nav class="-mx-4 grid grid-cols-3 gap-2 bg-surface px-4 py-2">
		@filterLink(PackURL(page.Trip.ID), "Everyone", page.Filter == 0)
		for _, m := range page.FilterOrder() {
			@filterLink(packMemberURL(page.Trip.ID, m.ID), m.Name, page.Filter == m.ID)
		}
	</nav>
}

// filterLink marks the one being viewed in solid blue, so it is obvious
// whose things are on screen. aria-current carries that to a screen reader
// as well.
templ filterLink(url, label string, active bool) {
	if active {
		<a href={ templ.SafeURL(url) } aria-current="page" class={ filterPillClass + " border-primary bg-primary text-white" }><span class="truncate">{ label }</span></a>
	} else {
		<a href={ templ.SafeURL(url) } class={ filterPillClass + " border-line-strong bg-surface text-ink" }><span class="truncate">{ label }</span></a>
	}
}

// filterPillClass fills its grid cell and centres its label, so every pill
// lines up the same width whatever the label's length.
const filterPillClass = "flex min-h-14 min-w-0 items-center justify-center rounded-control border px-2 text-center font-semibold"

// packMemberSection is one member's things to pack and their packed part.
// The heading is as on the trip page: the name, and how many items the
// member has, which packing never changes, so it is not swapped.
templ packMemberSection(page PackPageData, m PackMember) {
	<section data-member={ m.Name } class={ sectionClass }>
		<h2 class="flex items-baseline justify-between gap-3 px-4 pt-4 pb-2.5 text-lg font-bold">
			{ m.Name }
			<span class="text-sm font-normal text-muted tabular-nums">{ FormatItemCount(len(m.ToPack) + len(m.Packed)) }</span>
		</h2>
		@PackMemberList(page, m)
		@PackedPart(page, m, false)
	</section>
}

// PackMemberList is what one member still has to pack, the part a tap
// swaps. A member with nothing planned and a member who is finished both
// show no rows, so the wording has to tell them apart (02/S9).
templ PackMemberList(page PackPageData, m PackMember) {
	<div id={ toPackListID(m.ID) }>
		if !m.HasItems() {
			<p class="px-4 pb-4 text-[15px] text-muted">Nothing planned.</p>
		} else if len(m.ToPack) == 0 {
			<div class="px-4 pb-4">
				@doneNote() {
					All packed.
				}
			</div>
		} else {
			<ul class="divide-y divide-line border-t border-line">
				for _, it := range m.ToPack {
					@toPackRow(page, m, it)
				}
			</ul>
		}
	</div>
}

// toPackRow is one item still to pack. A planned item offers to prepare it,
// a prepared one offers to pack it and says so under its name. The two
// marks differ in shape (an empty square, and a circle with a dot), not
// only in colour, and each row's spoken label names the step its tap takes.
// A prepared row is tinted amber and has a back button at its very end,
// after the quantity, that takes it back to planned. The back button is a
// form of its own beside the row's tap, because a button cannot hold a
// button.
templ toPackRow(page PackPageData, m PackMember, it Item) {
	if it.Prepared {
		<li class="flex items-stretch bg-prepared-soft">
			@tapRow(packItemURL(page.Trip.ID, m.ID, it.ID, page.Filter), m, "Pack "+it.Name, toPackRowClass) {
				<span class="flex size-7 shrink-0 items-center justify-center rounded-full border-2 border-prepared">
					<span class="size-3 rounded-full bg-prepared"></span>
				</span>
				<span class="min-w-0 grow">
					{ it.Name }
					<span class="block text-sm font-semibold text-prepared">Prepared</span>
				</span>
				@packQuantity(it.Quantity, "font-bold")
			}
			@tapForm(unprepareItemURL(page.Trip.ID, m.ID, it.ID, page.Filter), m, "flex") {
				<button type="submit" aria-label={ "Back to planned: " + it.Name } class="flex w-14 items-center justify-center border-l border-prepared-line text-prepared active:bg-prepared-line">
					@iconUndo()
				</button>
			}
		</li>
	} else {
		<li class="flex">
			@tapRow(prepareItemURL(page.Trip.ID, m.ID, it.ID, page.Filter), m, "Prepare "+it.Name, toPackRowClass) {
				<span class="size-7 shrink-0 rounded-box border-2 border-faint"></span>
				<span class="min-w-0 grow">{ it.Name }</span>
				@packQuantity(it.Quantity, "font-bold")
			}
		</li>
	}
}

// packQuantity is an item's quantity on the packing page, shown only when
// there is more than one (09/S11): "1 pc" on every other row was noise
// while packing. The trip page keeps it, where the quantity is being set.
templ packQuantity(n int64, class string) {
	if n > 1 {
		<span class={ "shrink-0 whitespace-nowrap tabular-nums " + class }>{ FormatQuantity(n) }</span>
	}
}

// PackedPart holds what one member already has in the bag. The wrapper is
// always on the page, so there is a stable place to swap it into when the
// first item is packed; the <details> inside exists only while something is
// packed, so a member with nothing packed shows no "Packed (0)" (08/S1).
// Once it exists, a tap swaps only the count and the list inside it, never
// the <details> itself, so it stays open while a parent works through it
// (02/S3). The whole wrapper is sent only when the part appears or goes.
templ PackedPart(page PackPageData, m PackMember, oob bool) {
	<div id={ packedPartID(m.ID) } { oobAttrs(oob)... }>
		if len(m.Packed) > 0 {
			<details class="group border-t border-line">
				@PackedSummary(page, m, false)
				@PackedList(page, m, false)
			</details>
		}
	</div>
}

// PackedSummary is the only thing saying the packed part can be opened and
// what is inside it. Flexing a <summary> drops the browser's own disclosure
// triangle, so the chevron here replaces it rather than decorating it.
// Swapped on every tap to keep the count honest.
templ PackedSummary(page PackPageData, m PackMember, oob bool) {
	<summary
		id={ packedSummaryID(m.ID) }
		{ oobAttrs(oob)... }
		class="flex min-h-12 cursor-pointer list-none items-center gap-2 px-4 font-semibold text-muted [&::-webkit-details-marker]:hidden"
	>
		<span class="text-faint transition-transform group-open:rotate-90">
			@iconForward()
		</span>
		<span>Packed ({ FormatCount(len(m.Packed)) })</span>
		<span class="ml-auto text-sm font-normal group-open:hidden">Show</span>
		<span class="ml-auto hidden text-sm font-normal group-open:inline">Hide</span>
	</summary>
}

// PackedList is the member's packed items, each one a tap to take it back.
// The rows are lower than the ones still to pack, with the name struck
// through, so the part reads as done.
templ PackedList(page PackPageData, m PackMember, oob bool) {
	<div id={ packedListID(m.ID) } { oobAttrs(oob)... }>
		<ul class="divide-y divide-line border-t border-line">
			for _, it := range m.Packed {
				<li class="flex">
					@tapRow(unpackItemURL(page.Trip.ID, m.ID, it.ID, page.Filter), m, "Unpack "+it.Name, packedRowClass) {
						<span class="flex size-6 shrink-0 items-center justify-center rounded-box bg-packed text-white">
							@iconTick("size-4 stroke-3")
						</span>
						<span class="min-w-0 grow text-muted line-through">{ it.Name }</span>
						@packQuantity(it.Quantity, "text-muted")
					}
				</li>
			}
		</ul>
	</div>
}

// PackChanged answers a tap: the member's own list is swapped into place,
// and their packed part and the progress are updated out of band. wholePart
// says the page that sent the tap may not show the part as it now is (it
// appeared, went, or the page was out of date), so the wrapper is swapped;
// otherwise only the count and the list are, because sending the <details>
// again would close it.
templ PackChanged(page PackPageData, m PackMember, wholePart bool) {
	@PackMemberList(page, m)
	if wholePart {
		@PackedPart(page, m, true)
	} else {
		@PackedSummary(page, m, true)
		@PackedList(page, m, true)
	}
	@PackProgress(page, true)
}

// toPackRowClass and packedRowClass are a row's tap: its whole width up to
// any back button, so packing works one-handed with a bag in the other.
// A row still to pack is 64px high, a packed one 52px.
const toPackRowClass = "flex min-h-16 w-full min-w-0 items-center gap-3 px-4 py-2 text-left active:bg-primary-soft"
const packedRowClass = "flex min-h-13 w-full min-w-0 items-center gap-3 px-4 py-1.5 text-left active:bg-primary-soft"

// tapRow makes a row's tap a full-width submit button. The form grows to
// fill the row, leaving room only for a back button after it.
templ tapRow(action string, m PackMember, label, class string) {
	@tapForm(action, m, "flex min-w-0 grow") {
		<button type="submit" aria-label={ label } class={ class }>
			{ children... }
		</button>
	}
}

// tapForm is what every tap on the packing page shares: it swaps the
// member's list and queues behind earlier taps. It also tells the server
// whether this page shows the member's packed part, so the reply knows
// whether it can update only the count and the list inside it (see
// PackChanged). Every reply re-renders the member's list together with
// their packed part, so the field stays true to the page. Without
// JavaScript it is still a plain form post. class places the form in its
// row.
templ tapForm(action string, m PackMember, class string) {
	<form
		method="post"
		action={ templ.SafeURL(action) }
		hx-post={ action }
		hx-target={ "#" + toPackListID(m.ID) }
		hx-swap="outerHTML"
		hx-sync="body:queue all"
		class={ class }
	>
		<input type="hidden" name="packed_shown" value={ packedShown(m) }/>
		{ children... }
	</form>
}

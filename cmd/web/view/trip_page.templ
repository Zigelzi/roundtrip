package view

import "strconv"

// TripPage shows a trip and each family member's items. Each member is a
// <section data-member="Name"> with an id for jumping back to it. With
// page.Edit set, one row is a quantity form and every other row is locked.
// The header sticks to the top, and it has its own view-transition-name:
// during the edit transition every named row is lifted above the page, and
// without a name of its own the header would be drawn under the rows that
// are scrolled behind it.
//
// Tests read a member's section as running from its <section> to the first
// </section>, and its first <h2> as the member's heading (memberSection,
// memberHeading). So a section holds no nested <section>, and its first <h2>
// stays the member name.
templ TripPage(page TripPageData) {
	@Layout(page.Trip.Destination) {
		<header class={ topBarClass } style={ transitionName("trip-header") }>
			<div class="flex min-h-16 items-center gap-1 py-2 pr-4 pl-1">
				@backLink("/", "Back to trips")
				<div class="min-w-0 grow">
					<h1 class="truncate text-lg font-bold">{ page.Trip.Destination }</h1>
					<p class="truncate text-sm text-muted">{ FormatDateRange(page.Trip.Departure, page.Trip.DurationDays) } · { FormatDays(page.Trip.DurationDays) }</p>
				</div>
				<a href={ templ.SafeURL(PackURL(page.Trip.ID)) } class={ primaryButtonClass + " shrink-0" }>Start packing</a>
			</div>
			@jumpLinks(tripLinks(page.Members))
		</header>
		<div id={ tripItemsID } class="mt-2 space-y-2">
			for _, m := range page.Members {
				@memberSection(page.Trip.ID, m, page.Edit)
			}
		</div>
		<datalist id="item-names">
			for _, name := range page.Suggestions {
				<option value={ name }></option>
			}
		</datalist>
	}
}

// memberSection is one member's items plus the add form. The form sits
// outside the swapped item list: htmx replaces only the list, so the focused
// name field (and the phone keyboard) stays put between additions. The add
// form stays usable while a row is being edited (04); only rows lock.
templ memberSection(tripID int64, m MemberItems, edit ItemEdit) {
	<section id={ memberAnchor(m.ID) } data-member={ m.Name } style={ sectionTransition(memberAnchor(m.ID)) } class={ sectionClass + " " + anchorClass }>
		@MemberItemList(tripID, m, edit)
		<form
			method="post"
			action={ templ.SafeURL(addItemURL(tripID, m.ID, edit.ItemID)) }
			hx-post={ addItemURL(tripID, m.ID, edit.ItemID) }
			hx-target={ "#" + itemListID(m.ID) }
			hx-swap="outerHTML"
			hx-on::after-request="if (event.detail.xhr.status === 200) { this.reset(); this.elements['name'].focus() }"
			style={ transitionName("add-" + memberAnchor(m.ID)) }
			class="space-y-2 border-t border-line px-4 pt-3 pb-4"
		>
			<input type="text" name="name" value={ m.Form.Name } placeholder={ "Add an item for " + m.Name } list="item-names" autocomplete="off" aria-label={ "Item for " + m.Name } required class={ inputClass }/>
			<div class="flex items-center justify-between gap-2">
				@stepper(stepperField{Name: "quantity", Value: m.Form.Quantity, Label: "Quantity", Less: "Decrease quantity", More: "Increase quantity", Min: "1", Required: true, Low: 1})
				<button type="submit" class={ secondaryButtonClass + " min-w-28" }>Add</button>
			</div>
		</form>
	</section>
}

// MemberItemList is the part of a member's section that htmx swaps after an
// item is added or removed: the heading with its item count, the items and
// any validation errors. The heading is inside so the count stays right, and
// the count is inside the <h2>, which tests read as the member's heading.
// Without JavaScript the forms still work as plain posts with a redirect.
templ MemberItemList(tripID int64, m MemberItems, edit ItemEdit) {
	<div id={ itemListID(m.ID) }>
		<h2 class="flex items-baseline justify-between gap-3 px-4 pt-4 pb-2.5 text-lg font-bold">
			{ m.Name }
			<span class="text-sm font-normal text-muted tabular-nums">{ FormatItemCount(len(m.Items)) }</span>
		</h2>
		if len(m.Items) == 0 {
			<p class="px-4 pb-4 text-[15px] text-muted">No items yet.</p>
		} else {
			<ul class="divide-y divide-line border-t border-line">
				for _, it := range m.Items {
					if it.ID == edit.ItemID {
						@editItemRow(tripID, it, edit)
					} else {
						@itemRow(tripID, m.ID, it, edit.ItemID != 0)
					}
				}
			</ul>
		}
		<div class="px-4">
			@errorList(m.Form.Errors)
		</div>
	</div>
}

// itemRow is an item with its quantity and remove button. The name and the
// quantity are one button, so a tap anywhere on the row opens it for
// editing (09/S5); the dotted underline on the quantity is the hint that it
// can be tapped. Opening is a plain GET that reloads the page in edit mode
// for this row (so the lock can cover every member's section) and lands
// back on the row. ✕ is a separate 48px button at the end (09/R7). While
// another row is being edited, the whole row fades and both buttons are
// disabled, so neither the name, the quantity nor ✕ does anything.
templ itemRow(tripID, memberID int64, it Item, locked bool) {
	<li id={ itemAnchor(it.ID) } style={ rowTransition(itemAnchor(it.ID)) } class={ "flex min-h-14 items-stretch pr-1 " + anchorClass + lockedRow(locked) }>
		<form method="get" action={ templ.SafeURL(ItemURL(tripID, it.ID)) } hx-get={ TripURL(tripID) } { swapTripItems... } class="flex min-w-0 grow">
			<input type="hidden" name="edit" value={ strconv.FormatInt(it.ID, 10) }/>
			<button type="submit" aria-label={ "Change quantity of " + it.Name } disabled?={ locked } class={ rowTapClass }>
				<span class="min-w-0 grow">{ it.Name }</span>
				<span class={ quantityHintClass(it.Quantity == 1) }>{ FormatQuantity(it.Quantity) }</span>
			</button>
		</form>
		<form
			method="post"
			action={ templ.SafeURL(removeItemURL(tripID, it.ID)) }
			hx-post={ removeItemURL(tripID, it.ID) }
			hx-target={ "#" + itemListID(memberID) }
			hx-swap="outerHTML"
			class="flex"
		>
			<button type="submit" aria-label={ "Remove " + it.Name } disabled?={ locked } class={ removeButtonClass }>
				@iconRemove()
			</button>
		</form>
	</li>
}

// editItemRow is the row being edited: a small quantity form, tinted in the
// action colour (09/R5; amber now means prepared). Saving is a plain post
// that redirects back to the row; Cancel is a link to the plain trip page,
// back at the same row. The blue fill and lines alone mark the open row;
// the "· change quantity" hint added after 04's phone check was dropped at
// 09's (09/R5).
templ editItemRow(tripID int64, it Item, edit ItemEdit) {
	<li id={ itemAnchor(it.ID) } style={ rowTransition(itemAnchor(it.ID)) } class={ editRowClass + " " + anchorClass }>
		<form method="post" action={ templ.SafeURL(quantityURL(tripID, it.ID)) } hx-post={ quantityURL(tripID, it.ID) } { swapTripItems... } class="flex flex-col gap-2">
			<div class="flex items-center justify-between gap-2">
				<p class="min-w-0 font-bold">{ it.Name }</p>
				<a href={ templ.SafeURL(ItemURL(tripID, it.ID)) } hx-get={ TripURL(tripID) } { swapTripItems... } class={ quietButtonClass }>Cancel</a>
			</div>
			<div class="flex items-center justify-between gap-2">
				@stepper(stepperField{Name: "quantity", Value: edit.Quantity, Label: "New quantity for " + it.Name, Less: "Decrease quantity", More: "Increase quantity", Min: "1", Required: true, Low: 1})
				<button type="submit" class={ primaryButtonClass + " min-w-24" }>Save</button>
			</div>
		</form>
		@errorList(edit.Errors)
	</li>
}

// tripItemsID is the container holding every member's section. Opening a
// row for editing, saving and cancelling replace it in place with the same
// container from the full page reply (hx-select), instead of loading a new
// page: nothing above the row changes height, so the view stays where it
// was. transition:true animates between the two states with the browser's
// View Transitions API (see tailwind.css); browsers without it just swap.
// Without JavaScript the same controls fall back to plain page loads.
const tripItemsID = "trip-items"

var swapTripItems = templ.Attributes{
	"hx-target": "#" + tripItemsID,
	"hx-select": "#" + tripItemsID,
	"hx-swap":   "outerHTML transition:true",
}
